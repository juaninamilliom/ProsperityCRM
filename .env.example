# ─── Database ────────────────────────────────────────────────────────────────
# Local (Postgres.app / Homebrew):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/prosperity_crm
# Render/Neon/Supabase require SSL — set to "true" when pointing at a hosted DB.
PG_SSL=false
PG_POOL_MAX=10
# `npm run seed` truncates the funnel tables and only runs against a local
# host. To seed any other host you must name it, which is deliberate:
#   SEED_ALLOW_HOST=<the exact hostname in DATABASE_URL> npm run seed
SEED_ALLOW_HOST=

# ─── API ─────────────────────────────────────────────────────────────────────
API_PORT=4000
# Comma-separated list of allowed browser origins for CORS.
# Local: http://localhost:5173  |  Prod: https://<your-app>.vercel.app
CORS_ORIGINS=http://localhost:5173
# Where sign-in links point. Falls back to the first CORS_ORIGINS entry.
# Set one of the two in production: it is what stops a sign-in link from
# being built out of the caller's own Origin header.
APP_BASE_URL=http://localhost:5173
# Returns the magic link in the HTTP response so you can sign in without
# reading email. Local development only - never set this on a deployment.
MAGIC_LINK_DEV_URL=true

# ─── Secrets (required) ──────────────────────────────────────────────────────
# Guards the /admin super-admin routes via the x-admin-token header.
# Generate with: openssl rand -hex 32
ROOT_ADMIN_TOKEN=replace-me
# Signs local email/password bearer tokens.
# Generate with: openssl rand -hex 32
LOCAL_AUTH_SECRET=replace-me

# ─── SSO / OAuth (optional, not yet wired up) ────────────────────────────────
OAUTH_JWKS_URL=
OAUTH_ISSUER=
OAUTH_AUDIENCE=

# ─── Web (apps/web, Vite) ────────────────────────────────────────────────────
# Local: http://localhost:4000  |  Prod: https://<your-api>.onrender.com
VITE_API_BASE_URL=http://localhost:4000

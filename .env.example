# ─── Database ────────────────────────────────────────────────────────────────
# Local (Postgres.app / Homebrew):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/prosperity_crm
# Render/Neon/Supabase require SSL — set to "true" when pointing at a hosted DB.
PG_SSL=false
PG_POOL_MAX=10

# ─── API ─────────────────────────────────────────────────────────────────────
API_PORT=4000
# Comma-separated list of allowed browser origins for CORS.
# Local: http://localhost:5173  |  Prod: https://<your-app>.vercel.app
CORS_ORIGINS=http://localhost:5173

# ─── Secrets (required) ──────────────────────────────────────────────────────
# Guards the /admin super-admin routes via the x-admin-token header.
# Generate with: openssl rand -hex 32
ROOT_ADMIN_TOKEN=replace-me
# Signs local email/password bearer tokens.
# Generate with: openssl rand -hex 32
LOCAL_AUTH_SECRET=replace-me

# ─── SSO / OAuth (optional, not yet wired up) ────────────────────────────────
OAUTH_JWKS_URL=
OAUTH_ISSUER=
OAUTH_AUDIENCE=

# ─── Web (apps/web, Vite) ────────────────────────────────────────────────────
# Local: http://localhost:4000  |  Prod: https://<your-api>.onrender.com
VITE_API_BASE_URL=http://localhost:4000
